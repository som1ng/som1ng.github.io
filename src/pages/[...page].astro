---
import type {GetStaticPaths} from 'astro';
import type {Page} from 'astro';
import type {CollectionEntry} from 'astro:content';
import Pagination from '../components/control/Pagination.astro';
import PostPage from '../components/PostPage.astro';
import ArticleView from '../components/ArticleView.astro';
import ArchiveList from '../components/ArchiveList.astro';
import CategoryView from '../components/CategoryView.astro';
import {buildCategoryTree,flattenCategories,resolveCategoryPath} from '../utils/categories';
import MainGridLayout from '../layouts/MainGridLayout.astro';
import {getSortedPosts} from '../utils/content-utils';
import legacyPages from '../data/legacy-pages.json';
export const getStaticPaths=(async({paginate})=>{
const posts=await getSortedPosts();
const pages=paginate(posts,{pageSize:8});
const existing=new Set(pages.map(p=>p.params.page || ''));
const articles=posts.map(entry=>({params:{page:entry.slug},props:{entry}}));
for(const entry of posts)existing.add(entry.slug);
const categoryRoutes=flattenCategories(buildCategoryTree(posts)).map(node=>'categories/'+node.path.join('/'));
const legacy=[...new Set([...legacyPages,'categories',...categoryRoutes])].filter(route=>!existing.has(route)&&!['about','archive','series'].includes(route)).map(route=>({params:{page:route},props:{legacyRoute:route}}));
return [...pages,...articles,...legacy];
}) satisfies GetStaticPaths;
const {entry,page,legacyRoute}=Astro.props as {entry?:CollectionEntry<'posts'>;page?:Page<CollectionEntry<'posts'>>;legacyRoute?:string;};
const allPosts=await getSortedPosts();let selected=allPosts;let title='文章归档';let selectedCategory:string[]|undefined;
if(legacyRoute){
const parts=decodeURIComponent(legacyRoute).split('/');
if(parts[0]==='categories'){selectedCategory=resolveCategoryPath(parts.slice(1,parts.indexOf('page')>=0?parts.indexOf('page'):undefined),buildCategoryTree(allPosts));title=selectedCategory.at(-1)||'文章分类';}
if(parts[0]==='tags'){title=parts[1]?'#'+parts[1]:'主题标签';if(parts[1])selected=selected.filter(p=>p.data.tags.includes(parts[1]));}
if(parts[0]==='archives'&&parts[1]&&/^\d{4}$/.test(parts[1]))selected=selected.filter(p=>p.data.published.toISOString().startsWith(parts[1]+(parts[2]&&/^\d{2}$/.test(parts[2])?'-'+parts[2]:'')));
if(parts[0]==='page'){const number=Number(parts[1]);selected=selected.slice((number-1)*10,number*10);}
}
---
{entry ? <ArticleView entry={entry}/> : page ? <MainGridLayout><h1 class="sr-only">s0m1ng 的学习笔记</h1><PostPage page={page}/><Pagination page={page} class="mt-6" /></MainGridLayout> : <MainGridLayout title={title}>{selectedCategory ? <CategoryView posts={allPosts} selectedPath={selectedCategory}/> : <ArchiveList posts={selected} title={title} />}</MainGridLayout>}
