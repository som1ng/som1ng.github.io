---
import type {CategoryNode} from '../utils/categories';
interface Props {nodes:CategoryNode[];active?:string;expanded?:boolean;}
const {nodes,active='',expanded=false}=Astro.props;
---
<ul class="category-tree">
{nodes.map(node=><li>
  {node.children.length ? <details class="category-branch" data-category-branch={node.key} open={expanded || active===node.key || active.startsWith(node.key+'/')}>
    <summary aria-label={`展开或收起 ${node.name} 的子分类`}>
      <a class="category-link" href={node.url} data-category-path={node.key} aria-current={active===node.key?'page':undefined}><span>{node.name}</span><small>{node.count}</small></a>
      <span class="category-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
    </summary>
    <div class="category-children"><Astro.self nodes={node.children} active={active} expanded={expanded} /></div>
  </details> : <a class="category-link category-leaf" href={node.url} data-category-path={node.key} aria-current={active===node.key?'page':undefined}><span>{node.name}</span><small>{node.count}</small></a>}
</li>)}
</ul>
